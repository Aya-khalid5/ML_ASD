# ---------------------------------------------------------------------------
# ASD Screening Application — Environment Variables
# Copy this file to `.env` and adjust the values for your setup.
# Never commit real credentials or production URLs.
# ---------------------------------------------------------------------------

# --- Frontend (Next.js) ----------------------------------------------------
# Public URL the browser uses to reach the FastAPI backend.
# In local development with docker-compose this is http://localhost:8000.
# When the frontend is deployed on Vercel, set this to your Render backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) -----------------------------------------------------
# Comma-separated list of allowed CORS origins. "*" allows any origin,
# which is convenient for a public demo API.
CORS_ORIGINS=http://localhost:3000

# Optional overrides for the model artifact paths (used by Docker/Render).
# ASD_MODEL_PATH=./artifacts/asd_best_model.joblib
# ASD_METADATA_PATH=./artifacts/asd_model_metadata.joblib

